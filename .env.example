# Copy to .env and adjust.
# Any OpenAI-compatible self-hosted server (Ollama default port 11434).
LLM_BASE_URL=http://localhost:11434/v1
# 6GB VRAM: qwen2.5:7b (better, ~4.7GB) or qwen2.5:3b (faster). After fine-tune: hotel-receptionist
LLM_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=180
MAX_TOOL_ROUNDS=5
HISTORY_MESSAGES=12
HOLD_MINUTES=30
# DB_PATH=data/hotel.db
